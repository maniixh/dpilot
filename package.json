{
  "name": "dpilot",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run --filter \"@dpilot/web\" build",
    "compile": "bun run build && bun run --filter \"@dpilot/server\" compile",
    "test": "bun test",
    "typecheck": "bun run --filter \"*\" typecheck && bunx tsc --noEmit -p scripts",
    "lint": "bunx biome check .",
    "format": "bunx biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
